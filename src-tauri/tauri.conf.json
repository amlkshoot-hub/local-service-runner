{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalServiceRunner",
  "version": "1.0.0",
  "identifier": "com.local.service.runner",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Service Runner — Spring Boot 服务运行管理器",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 550,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
